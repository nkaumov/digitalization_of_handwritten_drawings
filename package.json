{
  "name": "digitalization-of-handwritten-drawings",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev:web": "pnpm --filter @app/web dev",
    "dev:api": "pnpm --filter @app/api dev",
    "build": "pnpm -r --filter ./apps/* --filter ./packages/* build",
    "typecheck": "pnpm -r --filter ./apps/* --filter ./packages/* typecheck",
    "lint": "pnpm -r --filter ./apps/* --filter ./packages/* lint",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
